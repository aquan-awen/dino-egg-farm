local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Hàm tạo ESP (Viền + Nhãn Tên & Khoảng cách)
local function applyESP(vậtThể)
    local targetPart = vậtThể:IsA("BasePart") and vậtThể or vậtThể:FindFirstChildWhichIsA("BasePart")
    if not targetPart then return end

    -- Tạo Highlight
    if not vậtThể:FindFirstChild("ESPHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.FillColor = Color3.fromRGB(255, 215, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = vậtThể
    end

    -- Tạo BillboardGui (Tên + Khoảng cách)
    if not targetPart:FindFirstChild("ESPNameTag") then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ESPNameTag"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 150, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 3, 0)

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = bgui

        bgui.Parent = targetPart

        task.spawn(function()
            while vậtThể and vậtThể.Parent and bgui.Parent do
                if hrp and targetPart then
                    local dist = math.floor((hrp.Position - targetPart.Position).Magnitude)
                    textLabel.Text = vậtThể.Name .. " [" .. dist .. "m]"
                end
                task.wait(0.2)
            end
        end)
    end
end

-- 2. Hàm di chuyển nhân vật
local function teleportTo(cframe)
    if not hrp then return end
    local tween = TweenService:Create(hrp, TweenInfo.new(1.2, Enum.EasingStyle.Linear), {CFrame = cframe})
    tween:Play()
    tween.Completed:Wait()
end

