local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Biến Bật/Tắt hệ thống (Đổi thành false nếu muốn dừng lại)
_G.AutoTeleport = true

-- 2. Tìm thư mục EggHuntSpawns
local spawnFolder = workspace:FindFirstChild("EggHuntSpawns")

if not spawnFolder then
    warn("Không tìm thấy thư mục EggHuntSpawns trong Workspace!")
    return
end

-- 3. Hàm tạo ESP
local function applyESP(part, index)
    if not part:IsA("BasePart") then return end

    if not part:FindFirstChild("ESPHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.FillColor = Color3.fromRGB(0, 255, 128)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = part
    end

    if not part:FindFirstChild("ESPNameTag") then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ESPNameTag"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 150, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 3, 0)

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = bgui
        bgui.Parent = part

        task.spawn(function()
            while part and part.Parent and bgui.Parent do
                if hrp then
                    local dist = math.floor((hrp.Position - part.Position).Magnitude)
                    textLabel.Text = "Egg Spawn #" .. index .. " [" .. dist .. "m]"
                end
                task.wait(0.2)
            end
        end)
    end
end

-- 4. Vòng lặp Teleport TỨC THÌ (Chỉ đến nơi CÓ TRỨNG)
task.spawn(function()
    local spawnList = spawnFolder:GetChildren()
    
    -- Gắn ESP cho tất cả điểm spawn
    for index, spawnPart in pairs(spawnList) do
        applyESP(spawnPart, index)
    end

    -- Vòng lặp tự động kiểm tra liên tục
    while _G.AutoTeleport do
        for index, spawnPart in pairs(spawnList) do
            -- Kiểm tra nếu Bật/Tắt bị hủy giữa chừng
            if not _G.AutoTeleport then break end

            if spawnPart:IsA("BasePart") then
                -- KIỂM TRA ĐIỀU KIỆN: Điểm Spawn có chứa Trứng (có child bên trong hoặc chứa Mesh)
                local hasEgg = #spawnPart:GetChildren() > 2 -- Bỏ qua ESPHighlight & ESPNameTag đã gắn
                
                if hasEgg then
                    -- TELEPORT TỨC THÌ: Gán CFrame trực tiếp (không dùng Tween/bay)
                    hrp.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
                    
                    task.wait(0.3) -- Nghỉ ngắn 0.3s tại điểm có trứng
                end
            end
        end
        task.wait(0.5) -- Đợi 0.5s trước khi bắt đầu lượt quét mới
    end
    print("Hệ thống Teleport: ĐÃ DỪNG LẠI.")
end)
