local function CreateButton(name, posY, toggleVar)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = MainFrame

    btn.MouseButton1Click:Connect(function()
        _G[toggleVar] = not _G[toggleVar]
        if _G[toggleVar] then
            btn.Text = name .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        else
            btn.Text = name .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)
    return btn
end

CreateButton("1. Auto Collect", 45, "AutoCollect")
CreateButton("2. Auto Hatch", 95, "AutoHatch")
CreateButton("3. ESP Trứng", 145, "ESPTrung")
CreateButton("4. Auto Teleport", 195, "AutoTeleport")

-- 3. HÀM TÌM TRỨNG THẬT TRONG SPAWN
local spawnFolder = Workspace:FindFirstChild("EggHuntSpawns")

local function getEggModel(spawnPart)
    for _, child in pairs(spawnPart:GetDescendants()) do
        if child.Name ~= "ESPHighlight" and child.Name ~= "ESPNameTag" and not child:IsA("BillboardGui") and not child:IsA("Highlight") then
            if child:IsA("Model") or child:IsA("BasePart") or child:IsA("MeshPart") then
                return child
            end
        end
    end
    return nil
end

-- 4. VÒNG LẶP XỬ LÝ
task.spawn(function()
    while true do
        Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        HRP = Character:FindFirstChild("HumanoidRootPart")

        if HRP then
            -- 1. AUTO COLLECT (Hút Tiền/Xương rơi trên map về phía nhân vật)
            if _G.AutoCollect then
                for _, item in pairs(Workspace:GetChildren()) do
                    if item:IsA("BasePart") or item:IsA("Model") then
                        local itemName = item.Name:lower()
                        if itemName:find("coin") or itemName:find("bone") or itemName:find("gem") or itemName:find("drop") or itemName:find("collect") then
                            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                            if part then
                                -- Dịch chuyển vật phẩm rơi thẳng vào người chơi để kích hoạt nhặt
                                part.CFrame = HRP.CFrame
                                if firetouchinterest then
                                    firetouchinterest(HRP, part, 0)
                                    task.wait(0.01)
                                    firetouchinterest(HRP, part, 1)
                                end
                            end
                        end
                    end
                end
            end

            -- 4. AUTO TELEPORT & NHẶT TRỨNG
            if _G.AutoTeleport and spawnFolder then
                for _, spawnPart in pairs(spawnFolder:GetChildren()) do
                    if not _G.AutoTeleport then break end
                    local egg = getEggModel(spawnPart)

                    if egg then
                        local targetPart = spawnPart:IsA("BasePart") and spawnPart or (egg:IsA("BasePart") and egg or egg:FindFirstChildWhichIsA("BasePart", true))
                        if targetPart then
                            -- Dịch chuyển nhân vật đè hẳn lên trứng
                            HRP.CFrame = targetPart.CFrame

                            -- Thử kích hoạt tất cả ProximityPrompt trong khu vực trứng
                            for _, prompt in pairs(spawnPart:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    fireproximityprompt(prompt)
                                end
                            end
                            for _, prompt in pairs(egg:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    fireproximityprompt(prompt)
                                end
                            end

                            -- Giả lập chạm trực tiếp vào cả điểm Spawn lẫn Trứng
                            if firetouchinterest then
                                firetouchinterest(HRP, targetPart, 0)
                                task.wait(0.05)
                                firetouchinterest(HRP, targetPart, 1)
                            end

                            -- Gửi Remote Event nếu game yêu cầu
                            for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                if remote:IsA("RemoteEvent") and (remote.Name:lower():find("egg") or remote.Name:lower():find("collect") or remote.Name:lower():find("claim")) then
                                    pcall(function()
                                        remote:FireServer(spawnPart)
                                        remote:FireServer(egg)
                                    end)
                                end
                            end

                            task.wait(0.25)
                        end
                    end
                end
            end
        end

        task.wait(0.1)
    end
end)
