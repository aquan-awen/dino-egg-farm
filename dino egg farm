local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Biến kiểm soát trạng thái
_G.AutoTeleport = false

-- 2. Tìm folder EggHuntSpawns
local spawnFolder = workspace:FindFirstChild("EggHuntSpawns")
if not spawnFolder then
    warn("Không tìm thấy EggHuntSpawns trong Workspace!")
    return
end

-- 3. TẠO GIAO DIỆN NÚT BẬT/TẮT TRÊN MÀN HÌNH
local playerGui = player:WaitForChild("PlayerGui")
local oldGui = playerGui:FindFirstChild("EggTeleportGui")
if oldGui then oldGui:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "EggTeleportGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 150, 0, 50)
toggleButton.Position = UDim2.new(0, 20, 0.4, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
toggleButton.Text = "AUTO TP: OFF"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 16
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.Active = true
toggleButton.Draggable = true
toggleButton.Parent = screenGui

toggleButton.MouseButton1Click:Connect(function()
    _G.AutoTeleport = not _G.AutoTeleport
    if _G.AutoTeleport then
        toggleButton.Text = "AUTO TP: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 200, 80)
    else
        toggleButton.Text = "AUTO TP: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
end)

-- 4. HÀM TÌM TRỨNG (Chỉ loại trừ các đối tượng ESP/UI do script tạo ra)
local function getEggObject(spawnPart)
    for _, child in pairs(spawnPart:GetDescendants()) do
        if child.Name ~= "ESPHighlight" and child.Name ~= "ESPNameTag" and not child:IsA("BillboardGui") and not child:IsA("Highlight") and not child:IsA("UIComponent") then
            if child:IsA("Model") or child:IsA("BasePart") or child:IsA("MeshPart") then
                return child
            end
        end
    end
    return nil
end

-- 5. HÀM CẬP NHẬT ESP
local function updateESP(spawnPart)
    local egg = getEggObject(spawnPart)
    local eggName = egg and egg.Name or "Không có trứng"

    local hl = spawnPart:FindFirstChild("ESPHighlight")
    if egg and not hl then
        hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.FillColor = Color3.fromRGB(0, 255, 128)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = spawnPart
    elseif not egg and hl then
        hl:Destroy()
    end

    local bgui = spawnPart:FindFirstChild("ESPNameTag")
    if not bgui then
        bgui = Instance.new("BillboardGui")
        bgui.Name = "ESPNameTag"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 150, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 3, 0)

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "Label"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 13
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = bgui
        bgui.Parent = spawnPart
    end

    local label = bgui:FindFirstChild("Label")
    if label and hrp then
        local dist = math.floor((hrp.Position - spawnPart.Position).Magnitude)
        label.Text = eggName .. " [" .. dist .. "m]"
    end
end

-- 6. VÒNG LẶP TELEPORT TỨC THÌ & MUA TRỨNG
task.spawn(function()
    while true do
        for _, spawnPart in pairs(spawnFolder:GetChildren()) do
            if spawnPart:IsA("BasePart") or spawnPart:IsA("Model") then
                updateESP(spawnPart)
            end
        end

        if _G.AutoTeleport then
            for _, spawnPart in pairs(spawnFolder:GetChildren()) do
                if not _G.AutoTeleport then break end

                local egg = getEggObject(spawnPart)
                if egg then
                    character = player.Character or player.CharacterAdded:Wait()
                    hrp = character:FindFirstChild("HumanoidRootPart")

                    if hrp then
                        -- Teleport đến vị trí điểm Spawn / Trứng
                        local targetPos = spawnPart:IsA("BasePart") and spawnPart.CFrame or (egg:IsA("BasePart") and egg.CFrame or nil)
                        if targetPos then
                            hrp.CFrame = targetPos * CFrame.new(0, 2, 0)

                            -- Kích hoạt ProximityPrompt nếu game dùng phím tương tác
                            local prompt = spawnPart:FindFirstChildWhichIsA("ProximityPrompt", true) or egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt then
                                fireproximityprompt(prompt)
                            end

                            -- Giả lập Touch nếu game dùng cơ chế dẫm/chạm vào trứng
                            if firetouchinterest then
                                local touchTarget = spawnPart:IsA("BasePart") and spawnPart or (egg:IsA("BasePart") and egg or nil)
                                if touchTarget then
                                    firetouchinterest(hrp, touchTarget, 0)
                                    task.wait(0.05)
                                    firetouchinterest(hrp, touchTarget, 1)
                                end
                            end

                            task.wait(0.2)
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
end)
