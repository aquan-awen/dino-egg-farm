local HRP = Character:WaitForChild("HumanoidRootPart")

-- 1. TRẠNG THÁI BẬT/TẮT TÍNH NĂNG
_G.AutoCollect = false
_G.AutoHatch = false
_G.ESPTrung = false
_G.AutoTeleport = false

-- 2. TẠO GIAO DIỆN MENU
