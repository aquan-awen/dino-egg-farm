local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Hàm dịch chuyển nhân vật tới vị trí mục tiêu
local function moveToPosition(targetCFrame, duration)
    if not hrp then return end
    
    local tweenInfo = TweenInfo.new(
        duration or 1.5,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    
    local goal = { CFrame = targetCFrame }
    local tween = TweenService:Create(hrp, tweenInfo, goal)
    tween:Play()
    tween.Completed:Wait() -- Chờ di chuyển xong mới làm việc tiếp theo
end

-- 2. Hàm gắn Highlight (ESP) cho một vật thể
local function createESP(object)
    if not object:FindFirstChild("ItemTracker") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ItemTracker"
        highlight.FillColor = Color3.fromRGB(0, 255, 128)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = object
    end
end

-- 3. Quét toàn bộ Workspace để tìm và gắn ESP + Dịch chuyển
task.spawn(function()
    for _, object in pairs(workspace:GetDescendants()) do
        -- Kiểm tra nếu đối tượng có chứa từ "Egg", "Chest" hoặc "Item" trong tên
        local nameLower = string.lower(object.Name)
        if (string.find(nameLower, "egg") or string.find(nameLower, "chest") or string.find(nameLower, "item")) and (object:IsA("BasePart") or object:IsA("Model")) then
            
            -- Gắn ESP
            createESP(object)
            
            -- Lấy CFrame mục tiêu
            local targetCFrame = object:IsA("Model") and object:GetPivot() or object.CFrame
            
            -- Dịch chuyển tới vị trí (dịch lên cao 3 stud để tránh kẹt đất)
            moveToPosition(targetCFrame * CFrame.new(0, 3, 0), 1.5)
            
            task.wait(0.5) -- Nghỉ 0.5 giây trước khi sang mục tiêu tiếp theo
        end
    end
end)
