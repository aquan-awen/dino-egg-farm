local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Biến trạng thái Bật/Tắt
_G.AutoTeleport = false

-- 2. Tìm thư mục EggHuntSpawns trong Workspace
local spawnFolder = workspace:FindFirstChild("EggHuntSpawns")
if not spawnFolder then
    warn("Không tìm thấy EggHuntSpawns trong Workspace!")
    return
end

-- 3. TẠO GIAO DIỆN NÚT BẬT/TẮT TRÊN MÀN HÌNH
local CoreGui = game:GetService("CoreGui")
local oldGui = CoreGui:FindFirstChild("EggTeleportGui")
if oldGui then oldGui:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "EggTeleportGui"
screenGui.Parent = CoreGui

local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0, 140, 0, 45)
toggleButton.Position = UDim2.new(0, 20, 0.4, 0) -- Vị trí góc trái màn hình
toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- Mặc định màu đỏ (OFF)
toggleButton.Text = "AUTO TP: OFF"
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleButton.TextSize = 15
toggleButton.Font = Enum.Font.SourceSansBold
toggleButton.Active = true
toggleButton.Draggable = true -- Có thể kéo di chuyển nút trên màn hình
toggleButton.Parent = screenGui

-- Xử lý sự kiện khi bấm nút
toggleButton.MouseButton1Click:Connect(function()
    _G.AutoTeleport = not _G.AutoTeleport
    if _G.AutoTeleport then
        toggleButton.Text = "AUTO TP: ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(40, 200, 80) -- Đổi sang màu xanh (ON)
    else
        toggleButton.Text = "AUTO TP: OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- Đổi sang màu đỏ (OFF)
    end
end)

-- 4. HÀM KIỂM TRA ĐIỂM SPAWN CÓ TRỨNG THẬT HAY KHÔNG
local function checkHasEgg(spawnPart)
    -- Duyệt các vật thể bên trong điểm Spawn
    for _, child in pairs(spawnPart:GetChildren()) do
        -- Trứng trong game này thường là MeshPart, SpecialMesh, hoặc Model
        if child:IsA("Model") or child:IsA("MeshPart") or child:IsA("SpecialMesh") then
            return true -- Xác nhận CÓ TRỨNG
        end
    end
    return false -- Không có trứng (điểm trống)
end

-- 5. VÒNG LẶP XỬ LÝ TELEPORT TỨC THÌ
task.spawn(function()
    while true do
        if _G.AutoTeleport then
            for _, spawnPart in pairs(spawnFolder:GetChildren()) do
                -- Nếu trong lúc đang chạy mà bấm nút OFF thì dừng ngay
                if not _G.AutoTeleport then break end

                if spawnPart:IsA("BasePart") and checkHasEgg(spawnPart) then
                    -- Cập nhật lại hrp nếu nhân vật bị respawn
                    character = player.Character or player.CharacterAdded:Wait()
                    hrp = character:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- TELEPORT TỨC THÌ (Gán CFrame thẳng, không bay)
                        hrp.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.3) -- Nghỉ 0.3 giây tại điểm có trứng
                    end
                end
            end
        end
        task.wait(0.2) -- Chu kỳ quét lại mỗi 0.2 giây
    end
end)
