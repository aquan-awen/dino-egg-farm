-- 3. HÀM TÌM MODEL TRỨNG VÀ BẮT EVENT
local spawnFolder = Workspace:FindFirstChild("EggHuntSpawns")

local function getEggModel(spawnPart)
    for _, child in pairs(spawnPart:GetChildren()) do
        if child.Name ~= "ESPHighlight" and child.Name ~= "ESPNameTag" and not child:IsA("BillboardGui") and not child:IsA("Highlight") then
            if child:IsA("Model") or child:IsA("BasePart") then
                return child
            end
        end
    end
    return nil
end

-- 4. TÍNH NĂNG 3: CẬP NHẬT ESP HIỂN THỊ
local function updateESP()
    if not spawnFolder then return end
    for _, spawnPart in pairs(spawnFolder:GetChildren()) do
        local egg = getEggModel(spawnPart)
        local hl = spawnPart:FindFirstChild("ESPHighlight")
        local bgui = spawnPart:FindFirstChild("ESPNameTag")

        if _G.ESPTrung and egg then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "ESPHighlight"
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = spawnPart
            end

            if not bgui then
                bgui = Instance.new("BillboardGui")
                bgui.Name = "ESPNameTag"
                bgui.AlwaysOnTop = true
                bgui.Size = UDim2.new(0, 150, 0, 30)
                bgui.StudsOffset = Vector3.new(0, 3, 0)

                local textLabel = Instance.new("TextLabel")
                textLabel.Name = "Label"
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
                textLabel.TextStrokeTransparency = 0
                textLabel.TextSize = 13
                textLabel.Font = Enum.Font.SourceSansBold
                textLabel.Parent = bgui
                bgui.Parent = spawnPart
            end

            local label = bgui:FindFirstChild("Label")
            if label and HRP then
                local dist = math.floor((HRP.Position - spawnPart.Position).Magnitude)
                label.Text = egg.Name .. " [" .. dist .. "m]"
            end
        else
            if hl then hl:Destroy() end
            if bgui then bgui:Destroy() end
        end
    end
end

-- 5. VÒNG LẶP XỬ LÝ CHÍNH
task.spawn(function()
    while true do
        Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        HRP = Character:FindFirstChild("HumanoidRootPart")

        if HRP then
            -- 1. AUTO COLLECT (Gom xương Bones, Coins trên bản đồ)
            if _G.AutoCollect then
                for _, item in pairs(Workspace:GetChildren()) do
                    if item:IsA("BasePart") or item:IsA("Model") then
                        if item.Name == "Bones" or item.Name:find("Coin") or item.Name:find("Drop") then
                            local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                            if part then
                                HRP.CFrame = part.CFrame
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end

            -- 2. AUTO HATCH (Gửi tín hiệu mở trứng trực tiếp tới Server)
            if _G.AutoHatch then
                for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                        if remote.Name:lower():find("hatch") or remote.Name:lower():find("open") or remote.Name:lower():find("buy") then
                            pcall(function()
                                if remote:IsA("RemoteEvent") then
                                    remote:FireServer(1)
                                else
                                    remote:InvokeServer(1)
                                end
                            end)
                        end
                    end
                end
            end

            -- 4. AUTO TELEPORT (Dịch chuyển đến điểm Spawn có Trứng & Kích hoạt Remote)
            if _G.AutoTeleport and spawnFolder then
                for _, spawnPart in pairs(spawnFolder:GetChildren()) do
                    if not _G.AutoTeleport then break end
                    local egg = getEggModel(spawnPart)

                    if spawnPart:IsA("BasePart") and egg then
                        HRP.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
                        
                        -- Thử kích hoạt ProximityPrompt hoặc giả lập Va chạm
                        local prompt = spawnPart:FindFirstChildWhichIsA("ProximityPrompt", true) or egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then fireproximityprompt(prompt) end

                        if firetouchinterest then
                            firetouchinterest(HRP, spawnPart, 0)
                            task.wait(0.05)
                            firetouchinterest(HRP, spawnPart, 1)
                        end

                        -- Kích hoạt RemoteEvent thu thập nếu có
                        for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                            if remote:IsA("RemoteEvent") and (remote.Name:lower():find("collect") or remote.Name:lower():find("egg")) then
                                pcall(function() remote:FireServer(spawnPart, egg) end)
                            end
                        end

                        task.wait(0.3)
                    end
                end
            end
        end

        -- Cập nhật ESP
        updateESP()

        task.wait(0.1)
    end
end)
