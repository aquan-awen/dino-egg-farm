local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- 1. Tìm đúng thư mục EggHuntSpawns trong Workspace
local spawnFolder = workspace:FindFirstChild("EggHuntSpawns")

if not spawnFolder then
    warn("Không tìm thấy thư mục EggHuntSpawns trong Workspace!")
    return
end

print("Đã tìm thấy EggHuntSpawns! Đang tạo ESP và di chuyển...")

-- 2. Hàm tạo ESP cho Part
local function applyESP(part, index)
    if not part:IsA("BasePart") then return end

    -- Tạo viền Highlight
    if not part:FindFirstChild("ESPHighlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.FillColor = Color3.fromRGB(0, 255, 128) -- Màu xanh lá
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = part
    end

    -- Tạo Nhãn Tên + Khoảng cách
    if not part:FindFirstChild("ESPNameTag") then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ESPNameTag"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 150, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 3, 0)

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Parent = bgui

        bgui.Parent = part

        task.spawn(function()
            while part and part.Parent and bgui.Parent do
                if hrp then
                    local dist = math.floor((hrp.Position - part.Position).Magnitude)
                    textLabel.Text = "Egg Spawn #" .. index .. " [" .. dist .. "m]"
                end
                task.wait(0.2)
            end
        end)
    end
end

-- 3. Vòng lặp gắn ESP và Dịch chuyển đến từng điểm Spawn
task.spawn(function()
    local spawnList = spawnFolder:GetChildren()
    
    -- Gắn ESP cho tất cả các điểm Spawn trước
    for index, spawnPart in pairs(spawnList) do
        applyESP(spawnPart, index)
    end

    -- Di chuyển lần lượt qua từng điểm
    for index, spawnPart in pairs(spawnList) do
        if spawnPart:IsA("BasePart") then
            -- Dịch chuyển nhân vật đến vị trí điểm Spawn (cao hơn 3 stud để không dính đất)
            local targetCFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
            local tween = TweenService:Create(hrp, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
            
            tween:Play()
            tween.Completed:Wait() -- Chờ bay tới nơi
            
            task.wait(0.5) -- Tạm dừng 0.5s tại mỗi điểm để nhặt/spawn trứng
        end
    end
end)
