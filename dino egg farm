-- Hàm gắn Highlight và Nhãn Tên cho một đối tượng
local function forceESP(obj)
    -- Kiểm tra nếu đã có Highlight thì bỏ qua
    if obj:FindFirstChild("ForceHighlight") then return end

    -- Tạo Highlight phát sáng xuyên tường
    local hl = Instance.new("Highlight")
    hl.Name = "ForceHighlight"
    hl.FillColor = Color3.fromRGB(0, 255, 128) -- Màu xanh lá
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = obj

    -- Tìm Part để gắn Nhãn tên
    local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
    if targetPart and not targetPart:FindFirstChild("ForceTag") then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ForceTag"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 200, 0, 40)
        bgui.StudsOffset = Vector3.new(0, 3, 0)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 0)
        label.TextStrokeTransparency = 0
        label.TextSize = 13
        label.Font = Enum.Font.SourceSansBold
        label.Text = obj.Name -- Hiện chính xác tên của Object trong game
        label.Parent = bgui

        bgui.Parent = targetPart
    end
end

