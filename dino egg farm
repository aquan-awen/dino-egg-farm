-- Hàm tạo nút bấm
local function CreateButton(name, posY, toggleVar)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 40)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = MainFrame

    btn.MouseButton1Click:Connect(function()
        _G[toggleVar] = not _G[toggleVar]
        if _G[toggleVar] then
            btn.Text = name .. ": ON"
            btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        else
            btn.Text = name .. ": OFF"
            btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        end
    end)
    return btn
end

-- Khởi tạo 4 nút cho 4 tính năng
CreateButton("1. Auto Collect", 45, "AutoCollect")
CreateButton("2. Auto Hatch", 95, "AutoHatch")
CreateButton("3. ESP Trứng", 145, "ESPTrung")
CreateButton("4. Auto Teleport", 195, "AutoTeleport")

-- 3. HÀM TÌM VÀ CẬP NHẬT ESP (TÍNH NĂNG 3)
local function UpdateESP()
    local eggFolder = Workspace:FindFirstChild("EggHuntSpawns") or Workspace:FindFirstChild("Eggs") or Workspace
    for _, item in pairs(eggFolder:GetDescendants()) do
        if item:IsA("BasePart") and (item.Name:lower():find("egg") or item.Parent.Name:lower():find("egg")) then
            local hl = item:FindFirstChild("ESPHighlight")
            if _G.ESPTrung then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ESPHighlight"
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = item
                end
            else
                if hl then hl:Destroy() end
            end
        end
    end
end

-- 4. VÒNG LẶP XỬ LÝ CHÍNH
task.spawn(function()
    while true do
        Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        HRP = Character:FindFirstChild("HumanoidRootPart")

        if HRP then
            -- 1. AUTO COLLECT (Tự động gom vật phẩm/tiền rơi trên sàn)
            if _G.AutoCollect then
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("BasePart") and (obj.Name:find("Coin") or obj.Name:find("Gem") or obj.Name:find("Drop")) then
                        if firetouchinterest then
                            firetouchinterest(HRP, obj, 0)
                            task.wait(0.01)
                            firetouchinterest(HRP, obj, 1)
                        end
                    end
                end
            end

            -- 2. AUTO HATCH (Tự động tương tác với nút/Khu vực mở trứng)
            if _G.AutoHatch then
                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and (prompt.Parent.Name:lower():find("egg") or prompt.ActionText:lower():find("hatch") or prompt.ActionText:lower():find("open")) then
                        if (HRP.Position - prompt.Parent:GetPivot().Position).Magnitude <= prompt.MaxActivationDistance then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end

            -- 4. AUTO TELEPORT (Tự động dịch chuyển tức thì tới các quả trứng gần nhất)
            if _G.AutoTeleport then
                local eggFolder = Workspace:FindFirstChild("EggHuntSpawns") or Workspace:FindFirstChild("Eggs") or Workspace
                for _, egg in pairs(eggFolder:GetDescendants()) do
                    if not _G.AutoTeleport then break end
                    if egg:IsA("BasePart") and (egg.Name:lower():find("egg") or egg.Parent.Name:lower():find("egg")) then
                        HRP.CFrame = egg.CFrame * CFrame.new(0, 3, 0)
                        
                        -- Tự chạm hoặc kích hoạt nút nhặt trứng
                        local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true) or egg.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then fireproximityprompt(prompt) end
                        if firetouchinterest then
                            firetouchinterest(HRP, egg, 0)
                            task.wait(0.02)
                            firetouchinterest(HRP, egg, 1)
                        end
                        task.wait(0.2)
                    end
                end
            end
        end

        -- Cập nhật ESP liên tục
        UpdateESP()

        task.wait(0.1)
    end
end)
